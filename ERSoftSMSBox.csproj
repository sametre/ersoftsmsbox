<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <DevExpressAssemblyPath Condition="'$(DevExpressAssemblyPath)' == ''">$(ProgramW6432)\DevExpress 25.1\Components\Bin\NetCore</DevExpressAssemblyPath>
    <!-- Uygulama kimlik bilgileri -->
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Company>ERSoft</Company>
    <Product>ERSoftSMSBox</Product>
    <Copyright>Copyright © 2024 ERSoft</Copyright>
    <Description>ERSoft SMS Yönetim Paneli</Description>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <NeutralResourcesLanguage>tr-TR</NeutralResourcesLanguage>
  </PropertyGroup>

  <ItemGroup>
    <None Include="ERSoftSMSBox.Tests\ERSoftSMSBox.Tests.csproj" />
    <None Include="obj\ShellSmokeTests\ShellSmokeTests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ERSoftSMSBox.Tests\**\*.cs;obj\ShellSmokeTests\**\*.cs;obj\NebimSmoke\**\*.cs" />
    <None Remove="obj\ShellSmokeTests\ShellSmokeTests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ERSoftSMSBox.Tests" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.8" />
    <Reference Include="DevExpress.XtraGrid.v25.1">
      <HintPath>$(DevExpressAssemblyPath)\DevExpress.XtraGrid.v25.1.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="DevExpress.XtraCharts.v25.1">
      <HintPath>$(DevExpressAssemblyPath)\DevExpress.XtraCharts.v25.1.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="DevExpress.XtraCharts.v25.1.UI">
      <HintPath>$(DevExpressAssemblyPath)\DevExpress.XtraCharts.v25.1.UI.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="DevExpress.Images.v25.1">
      <HintPath>$(DevExpressAssemblyPath)\DevExpress.Images.v25.1.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="DevExpress.Data.v25.1;DevExpress.Data.Desktop.v25.1;DevExpress.Drawing.v25.1;DevExpress.Utils.v25.1;DevExpress.XtraEditors.v25.1;DevExpress.XtraBars.v25.1;DevExpress.XtraLayout.v25.1;DevExpress.Printing.v25.1.Core;DevExpress.Sparkline.v25.1.Core">
      <HintPath>$(DevExpressAssemblyPath)\%(Identity).dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>